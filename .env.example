# ===================== LLM =====================
# Which backend powers the agents:
#   codex  = OpenAI Codex CLI signed in with your ChatGPT Plus/Pro account (NO API key). Run once: codex login
#   openai = OpenAI API key (Responses API)
#   chat   = any OpenAI-compatible Chat Completions endpoint (Gemini free tier, Ollama, LM Studio, OpenRouter)
LLM_BACKEND=codex
# Models per role. Leave EMPTY to use the backend's default (recommended for codex = your plan's default model).
MODEL_ORCHESTRATOR=
MODEL_CODER=
MODEL_VISION=
# --- codex backend ---
# low | medium | high  (empty = Codex default). Lower = faster and uses less of your plan's limits.
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SECONDS=1500
# Default: save progress and pause on a usage limit. Resume after your account resets.
# Set to 1 to wait and retry while the tool stays open (in 15-minute steps).
CODEX_WAIT_ON_LIMIT=0
# Suggested delay only; actual resets depend on your provider/account, including weekly limits.
CODEX_LIMIT_RETRY_MINUTES=300
CODEX_LIMIT_WAIT_MINUTES=300
# --- openai / chat backends ---
OPENAI_API_KEY=
# Examples for LLM_BACKEND=chat:
#   Gemini (free key: https://aistudio.google.com/apikey):
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   MODEL_*=gemini-2.5-pro
#   Ollama (local, free):  OPENAI_BASE_URL=http://localhost:11434/v1           MODEL_*=qwen2.5-coder:32b
#   LM Studio (local):     OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_BASE_URL=
LLM_JSON_MODE=1
# ===================== Unity =====================
# Full path to Unity.exe (Unity 6 / 6000.x). Unity Hub -> Installs -> gear icon -> Show in Explorer
UNITY_EDITOR=C:\Program Files\Unity\Hub\Editor\6000.0.40f1\Editor\Unity.exe
UNITY_TIMEOUT_SECONDS=1800
# ===================== Assets =====================
# Optional: Sketchfab API token (https://sketchfab.com/settings/password) for characters/animated models
SKETCHFAB_API_TOKEN=
ASSET_TEXTURE_RESOLUTION=1k
ASSET_MAX_FACES=150000
# ===================== Agent behaviour =====================
MAX_FIX_ATTEMPTS=4
POLISH_ROUNDS=2
CONTEXT_CHAR_BUDGET=90000
# auto uses deterministic briefs for small tasks with shared contracts; template skips all AI brief calls.
BRIEF_MODE=auto
# Cooperative per-run AI budgets, checked before each model request. Zero means unlimited.
MAX_LLM_CALLS=0
MAX_JOB_SECONDS=0

# Orchestration engine: auto (LangGraph if installed) | graph | legacy
ORCHESTRATOR_ENGINE=auto
MAX_PHASE_RETRIES=2
# Project-wide limits that persist across restarts (0 = unlimited)
MAX_PROJECT_TOKENS=0
MAX_PROJECT_COST_USD=0
# Optional USD per 1M tokens, e.g. {"my-model":[input,output,cached_input]}. No built-in prices.
LLM_PRICING_JSON=
# Optional cheaper model for brief generation
MODEL_LIGHT=

# Generated-code safety scan: strict (reject) | warn | off
CODE_POLICY=strict
# Android output: apk | aab. Release signing is read from LF_ANDROID_KEYSTORE / LF_ANDROID_KEYSTORE_PASS /
# LF_ANDROID_KEY_ALIAS / LF_ANDROID_KEY_ALIAS_PASS (environment only; debug-signed when unset)
LF_ANDROID_FORMAT=apk
# Bundle id prefix for mobile builds
LF_APP_ID_PREFIX=com.ludofabric
